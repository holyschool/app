FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT=/absolute/path/to/service-account.json
# Alternative to FCM_SERVICE_ACCOUNT (use one of the two):
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
FCM_TOPIC=edupage_all
SERVER_API_KEY=change-this-long-random
DATABASE_PATH=./data/edupage-notify.sqlite
ENCRYPTION_KEY_PATH=./data/master.key
RSA_KEYS_DIR=./data/keys
PORT=4580

POLL_INTERVAL_SECONDS=60
DEBUG_LOG=false

FIRST_RUN_NOTIFY=false
SEED_GRADES_ON_START=true
MESSAGE_PREVIEW_CHARS=140
